(
    <Slide
        style={{
            width: 1280,
            height: 720,
            background: '#FFFFFF',
            position: 'relative',
            paddingTop: 52,
            paddingBottom: 52,
            paddingLeft: 72,
            paddingRight: 72,
        }}
    >
        <Box
            style={{
                position: 'relative',
                zIndex: 1,
                width: '100%',
                height: '100%',
                flexDirection: 'column',
                justifyContent: 'space-between',
            }}
        >
            <Box style={{ flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', width: '100%' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                        <Box style={{ width: 48, height: 4, background: '#2563EB' }} />
                        <Text style={{ fontSize: 15, color: '#64748B', letterSpacing: 4 }}>D E M O · 页 面</Text>
                    </Box>
                    <Text style={{ fontSize: 13, fontFamily: 'Consolas', color: '#94A3B8' }}>22 / 26</Text>
                </Box>

                <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.3, marginTop: 16 }}>
                    先搭骨架：index.html
                </Text>
            </Box>

            <Box style={{ flexDirection: 'row', width: '100%', gap: 24 }}>
                <Box style={{ width: 720, flexDirection: 'column' }}>
                    <CodeBlock language='html' theme='github-light' macHeader={false}>
                        {`<h3>商品列表</h3>
<input type="text" id="search" placeholder="输入商品名称搜索">
<table>
  <thead>
    <tr><th>id</th><th>商品名</th><th>价格</th><th>库存</th></tr>
  </thead>
  <tbody id="table-body"></tbody>
</table>

<h4>新增商品</h4>
<div>
  <input id="title" placeholder="商品名称">
  <input id="price" placeholder="价格">
  <input id="stock" placeholder="库存">
  <button id="addBtn">提交新增</button>
</div>

<script type="module" src="./main.js"></script>`}
                    </CodeBlock>
                </Box>

                <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
                    <Box
                        style={{
                            background: '#F1F5F9',
                            borderRadius: 12,
                            paddingTop: 18,
                            paddingBottom: 18,
                            paddingLeft: 20,
                            paddingRight: 20,
                            flexDirection: 'row',
                            alignItems: 'center',
                            gap: 14,
                        }}
                    >
                        <FAIcon name='table' style={{ fill: '#2563EB', width: 22, height: 22 }} />
                        <Text style={{ fontSize: 16, color: '#0F172A' }}>
                            表格只留 tbody，数据由 JS 填
                        </Text>
                    </Box>

                    <Box
                        style={{
                            background: '#F1F5F9',
                            borderRadius: 12,
                            paddingTop: 18,
                            paddingBottom: 18,
                            paddingLeft: 20,
                            paddingRight: 20,
                            flexDirection: 'row',
                            alignItems: 'center',
                            gap: 14,
                        }}
                    >
                        <FAIcon name='id-card' style={{ fill: '#06B6D4', width: 22, height: 22 }} />
                        <Text style={{ fontSize: 16, color: '#0F172A' }}>
                            每个输入控件都有 id，方便 JS 选中
                        </Text>
                    </Box>

                    <Box
                        style={{
                            background: 'rgba(245,158,11,0.14)',
                            borderRadius: 12,
                            paddingTop: 18,
                            paddingBottom: 18,
                            paddingLeft: 20,
                            paddingRight: 20,
                            flexDirection: 'row',
                            alignItems: 'center',
                            gap: 14,
                        }}
                    >
                        <FAIcon name='code' style={{ fill: '#B45309', width: 22, height: 22 }} />
                        <Text style={{ fontSize: 16, color: '#0F172A' }}>
                            type="module" 才能用 import / 现代写法
                        </Text>
                    </Box>
                </Box>
            </Box>

            <Box
                style={{
                    width: '100%',
                    background: 'linear-gradient(120deg, #2563EB 0%, #06B6D4 100%)',
                    borderRadius: 14,
                    paddingTop: 22,
                    paddingBottom: 22,
                    paddingLeft: 32,
                    paddingRight: 32,
                    flexDirection: 'row',
                    alignItems: 'center',
                    gap: 18,
