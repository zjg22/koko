            >
                <FAIcon name='mouse-pointer' style={{ fill: '#FFFFFF', width: 26, height: 26 }} />
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.5 }}>
                    HTML 只负责"长什么样"，数据的事交给 main.js
                </Text>
            </Box>

            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', width: '100%' }}>
                <Text style={{ fontSize: 13, color: '#94A3B8' }}>第9周 · 前端 ↔ 后端接口交互</Text>
                <Text style={{ fontSize: 13, color: '#94A3B8' }}>22 / 26</Text>
            </Box>
