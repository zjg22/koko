(
    <Slide
        style={{
            width: 1280,
            height: 720,
            background: '#FFFFFF',
            position: 'relative',
            paddingTop: 52,
            paddingBottom: 52,
            paddingLeft: 72,
            paddingRight: 72,
        }}
    >
        <Box
            style={{
                position: 'relative',
                zIndex: 1,
                width: '100%',
                height: '100%',
                flexDirection: 'column',
                justifyContent: 'space-between',
            }}
        >
            <Box style={{ flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', width: '100%' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                        <Box style={{ width: 48, height: 4, background: '#F59E0B' }} />
                        <Text style={{ fontSize: 15, color: '#64748B', letterSpacing: 4 }}>F E T C H · P O S T</Text>
                    </Box>
                    <Text style={{ fontSize: 13, fontFamily: 'Consolas', color: '#94A3B8' }}>13 / 26</Text>
                </Box>

                <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.3, marginTop: 16 }}>
                    第二步：把数据交上去
                </Text>
            </Box>

            <Box style={{ flexDirection: 'row', width: '100%', gap: 28 }}>
                <Box style={{ width: 710, flexDirection: 'column' }}>
                    <CodeBlock language='javascript' theme='github-light' macHeader={false}>
                        {`// POST 请求：新增一条商品
fetch('http://localhost:3000/goods', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json'   // ① 不能漏
  },
  body: JSON.stringify({                 // ② 不能漏
    title: '蓝牙耳机',
    price: 129,
    stock: 88
  })
})
  .then(res => res.json())
  .then(ret => console.log('新增成功', ret))
  .catch(err => console.error('失败', err))`}
                    </CodeBlock>
                </Box>

                <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
                    <Box
                        style={{
                            background: 'linear-gradient(135deg, #2563EB 0%, #06B6D4 100%)',
                            borderRadius: 12,
                            paddingTop: 22,
                            paddingBottom: 22,
                            paddingLeft: 22,
                            paddingRight: 22,
                            flexDirection: 'column',
                        }}
                    >
                        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                            <FAIcon name='tag' style={{ fill: '#FFFFFF', width: 22, height: 22 }} />
                            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>
                                ① headers
                            </Text>
                        </Box>
                        <Text style={{ fontSize: 16, color: 'rgba(255,255,255,0.92)', marginTop: 10, lineHeight: 1.7 }}>
                            告诉后端"我发的是 JSON"，
                            不写后端可能解析不了。
                        </Text>
                    </Box>

                    <Box
                        style={{
                            background: 'rgba(245,158,11,0.16)',
                            borderRadius: 12,
                            paddingTop: 22,
                            paddingBottom: 22,
                            paddingLeft: 22,
                            paddingRight: 22,
                            flexDirection: 'column',
                        }}
                    >
                        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                            <FAIcon name='box' style={{ fill: '#B45309', width: 22, height: 22 }} />
                            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F172A' }}>
                                ② JSON.stringify
                            </Text>
                        </Box>
                        <Text style={{ fontSize: 16, color: '#64748B', marginTop: 10, lineHeight: 1.7 }}>
                            对象转成字符串。
                            直接传对象会变成 [object Object]。
                        </Text>
                    </Box>
                </Box>
            </Box>

            <Box
                style={{
                    width: '100%',
                    background: 'linear-gradient(120deg, #2563EB 0%, #06B6D4 100%)',
                    borderRadius: 14,
                    paddingTop: 22,
                    paddingBottom: 22,
                    paddingLeft: 32,
                    paddingRight: 32,
                    flexDirection: 'row',
                    alignItems: 'center',
                    gap: 18,
                }}
            >
                <FAIcon name='key' style={{ fill: '#FFFFFF', width: 26, height: 26 }} />
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.5 }}>
                    记住口诀：GET 查，POST 增；POST 要带 headers 和 stringify
                </Text>
            </Box>

            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', width: '100%' }}>
                <Text style={{ fontSize: 13, color: '#94A3B8' }}>第9周 · 前端 ↔ 后端接口交互</Text>
                <Text style={{ fontSize: 13, color: '#94A3B8' }}>13 / 26</Text>
            </Box>
        </Box>
    </Slide>
);
