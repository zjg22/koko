                    }}
                >
                    <Box style={{ flexDirection: 'column', alignItems: 'center', gap: 8 }}>
                        <Text style={{ fontSize: 19, fontFamily: 'Consolas', fontWeight: 'bold', color: '#0F172A' }}>http://</Text>
                        <Text style={{ fontSize: 14, color: '#64748B' }}>协议</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', alignItems: 'center', gap: 8 }}>
                        <Text style={{ fontSize: 19, fontFamily: 'Consolas', fontWeight: 'bold', color: '#0F172A' }}>localhost</Text>
                        <Text style={{ fontSize: 14, color: '#64748B' }}>域名</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', alignItems: 'center', gap: 8 }}>
                        <Text style={{ fontSize: 19, fontFamily: 'Consolas', fontWeight: 'bold', color: '#0F172A' }}>:3000</Text>
                        <Text style={{ fontSize: 14, color: '#64748B' }}>端口</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', alignItems: 'center', gap: 8 }}>
                        <Text style={{ fontSize: 19, fontFamily: 'Consolas', fontWeight: 'bold', color: '#0F172A' }}>/goods</Text>
                        <Text style={{ fontSize: 14, color: '#64748B' }}>路径</Text>
                    </Box>
                </Box>

                <Box
                    style={{
                        background: 'rgba(239,68,68,0.08)',
