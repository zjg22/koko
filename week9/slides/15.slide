                            paddingRight: 22,
                            flexDirection: 'column',
                        }}
                    >
                        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                            <FAIcon name='shield-alt' style={{ fill: '#2563EB', width: 22, height: 22 }} />
                            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F172A' }}>不存在跨域</Text>
                        </Box>
                        <Text style={{ fontSize: 15, color: '#64748B', marginTop: 10, lineHeight: 1.7 }}>
                            后端调用另一个后端
                            <br />
