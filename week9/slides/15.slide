                        paddingRight: 26,
                        flexDirection: 'column',
                        gap: 10,
                    }}
                >
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                        <FAIcon name='exclamation-triangle' style={{ fill: '#EF4444', width: 22, height: 22 }} />
                        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F172A' }}>
                            同源 = 协议 + 域名 + 端口 三者全一致
                        </Text>
                    </Box>
                    <Text style={{ fontSize: 16, color: '#64748B', lineHeight: 1.7 }}>
                        只要有一个不一样，就是跨域，浏览器就会拦。
                        前端在 5500 端口、后端在 3000 端口，端口不同 → 跨域。
                    </Text>
                </Box>

                <Box style={{ flexDirection: 'row', width: '100%', gap: 16 }}>
                    <Box
                        style={{
                            flex: 1,
