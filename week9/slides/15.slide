                position: 'relative',
                zIndex: 1,
                width: '100%',
                height: '100%',
                flexDirection: 'column',
                justifyContent: 'space-between',
            }}
        >
            <Box style={{ flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', width: '100%' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                        <Box style={{ width: 48, height: 4, background: '#EF4444' }} />
                        <Text style={{ fontSize: 15, color: '#64748B', letterSpacing: 4 }}>跨 域 · 高 频 坑</Text>
                    </Box>
                    <Text style={{ fontSize: 13, fontFamily: 'Consolas', color: '#94A3B8' }}>15 / 26</Text>
                    </Box>

                <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.3, marginTop: 16 }}>
                    代码没错，是浏览器拦的
                </Text>
            </Box>

            <Box style={{ flexDirection: 'column', width: '100%', gap: 16 }}>
                <Box
                    style={{
                        flexDirection: 'row',
                        alignItems: 'center',
                        gap: 0,
                        background: '#F1F5F9',
                        borderRadius: 12,
