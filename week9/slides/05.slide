                        <Text style={{ fontSize: 15, fontFamily: 'Consolas', color: '#FFFFFF', fontWeight: 'bold' }}>GET</Text>
                    </Box>
                    <Text style={{ fontSize: 17, color: '#0F172A' }}>
                        <Text style={{ fontWeight: 'bold' }}>查</Text> — 数据放在 URL 上 ?id=1&name=apple，不改服务器数据
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Box style={{ background: '#F59E0B', borderRadius: 5, paddingTop: 4, paddingBottom: 4, paddingLeft: 12, paddingRight: 12 }}>
