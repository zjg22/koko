                    </Box>
                    <Text style={{ fontSize: 13, fontFamily: 'Consolas', color: '#94A3B8' }}>05 / 26</Text>
                </Box>

                <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.3, marginTop: 16 }}>
                    一个请求，由三部分组成
                </Text>
            </Box>

            <Box style={{ flexDirection: 'column', width: '100%', gap: 12 }}>
                <Box
                    style={{
                        flexDirection: 'row',
                        alignItems: 'stretch',
                        background: '#F1F5F9',
                        borderRadius: 10,
                        paddingTop: 16,
                        paddingBottom: 16,
                        paddingLeft: 22,
                        paddingRight: 22,
                        gap: 20,
                    }}
                >
                    <Box
                        style={{
                            width: 130,
                            background: '#2563EB',
                            borderRadius: 8,
                            justifyContent: 'center',
                            alignItems: 'center',
                        }}
                    >
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>请求行</Text>
                    </Box>
                    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontFamily: 'Consolas', color: '#0F172A' }}>
                            POST /goods HTTP/1.1
                        </Text>
                        <Text style={{ fontSize: 14, color: '#64748B', marginTop: 5 }}>
                            请求方法 + 接口地址 + 协议版本
                        </Text>
                    </Box>
                </Box>

                <Box
                    style={{
                        flexDirection: 'row',
                        alignItems: 'stretch',
                        background: '#F1F5F9',
                        borderRadius: 10,
                        paddingTop: 16,
                        paddingBottom: 16,
                        paddingLeft: 22,
                        paddingRight: 22,
                        gap: 20,
                    }}
                >
                    <Box
                        style={{
                            width: 130,
                            background: '#06B6D4',
                            borderRadius: 8,
                            justifyContent: 'center',
                            alignItems: 'center',
                        }}
                    >
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>请求头</Text>
                    </Box>
                    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontFamily: 'Consolas', color: '#0F172A' }}>
                            Content-Type: application/json
                        </Text>
                        <Text style={{ fontSize: 14, color: '#64748B', marginTop: 5 }}>
                            附加信息：数据格式、身份凭证
                        </Text>
                    </Box>
                </Box>

                <Box
                    style={{
                        flexDirection: 'row',
                        alignItems: 'stretch',
                        background: '#F1F5F9',
                        borderRadius: 10,
                        paddingTop: 16,
                        paddingBottom: 16,
                        paddingLeft: 22,
                        paddingRight: 22,
                        gap: 20,
                    }}
                >
                    <Box
                        style={{
                            width: 130,
                            background: '#F59E0B',
                            borderRadius: 8,
                            justifyContent: 'center',
                        alignItems: 'center',
                        }}
                    >
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>请求体</Text>
                    </Box>
                    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontFamily: 'Consolas', color: '#0F172A' }}>
                            {"{"} "title": "蓝牙耳机", "price": 129 {"}"}
                        </Text>
                        <Text style={{ fontSize: 14, color: '#64748B', marginTop: 5 }}>
                            要交给后端的数据（GET 一般为空）
                        </Text>
                    </Box>
                </Box>
            </Box>

            <Box
                style={{
                    width: '100%',
                    background: '#FFFFFF',
                    borderWidth: 1,
                    borderColor: '#E2E8F0',
