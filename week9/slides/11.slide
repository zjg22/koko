                >
                    <Box style={{ width: 96 }}>
                        <Text style={{ fontSize: 16, fontFamily: 'Consolas', color: '#2563EB', fontWeight: 'bold' }}>Promise</Text>
                    </Box>
                    <Text style={{ flex: 1, fontSize: 16, color: '#64748B', lineHeight: 1.6 }}>
                        一个"承诺"，代表未来才会有的结果
                    </Text>
                </Box>
                <Box
                    style={{
                        background: '#FFFFFF',
                        borderWidth: 1,
                        borderColor: '#E2E8F0',
                        borderRadius: 10,
                        paddingTop: 16,
                        paddingBottom: 16,
                        paddingLeft: 22,
                        paddingRight: 22,
                        flexDirection: 'row',
                        alignItems: 'center',
                        gap: 16,
                    }}
                >
                    <Box style={{ width: 96 }}>
                        <Text style={{ fontSize: 16, fontFamily: 'Consolas', color: '#2563EB', fontWeight: 'bold' }}>.then()</Text>
                    </Box>
                    <Text style={{ flex: 1, fontSize: 16, color: '#64748B', lineHeight: 1.6 }}>
                        成功了之后要做什么
                    </Text>
                </Box>
                <Box
                    style={{
                        background: '#FFFFFF',
                        borderWidth: 1,
                        borderColor: '#E2E8F0',
                        borderRadius: 10,
                        paddingTop: 16,
                        paddingBottom: 16,
                        paddingLeft: 22,
                        paddingRight: 22,
                        flexDirection: 'row',
                        alignItems: 'center',
                        gap: 16,
                    }}
                >
                    <Box style={{ width: 96 }}>
                        <Text style={{ fontSize: 16, fontFamily: 'Consolas', color: '#2563EB', fontWeight: 'bold' }}>.catch()</Text>
                    </Box>
                    <Text style={{ flex: 1, fontSize: 16, color: '#64748B', lineHeight: 1.6 }}>
                        失败了怎么办（网络断了、服务没起）
                    </Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', width: '100%' }}>
                <Text style={{ fontSize: 13, color: '#94A3B8' }}>第9周 · 前端 ↔ 后端接口交互</Text>
                <Text style={{ fontSize: 13, color: '#94A3B8' }}>11 / 26</Text>
            </Box>
