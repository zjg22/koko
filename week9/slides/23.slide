(
    <Slide
        style={{
            width: 1280,
            height: 720,
            background: '#FFFFFF',
            position: 'relative',
            paddingTop: 52,
            paddingBottom: 52,
            paddingLeft: 72,
            paddingRight: 72,
        }}
    >
        <Box
            style={{
                position: 'relative',
                zIndex: 1,
                width: '100%',
                height: '100%',
                flexDirection: 'column',
                justifyContent: 'space-between',
            }}
        >
            <Box style={{ flexDirection: 'column' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', width: '100%' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                        <Box style={{ width: 48, height: 4, background: '#2563EB' }} />
                        <Text style={{ fontSize: 15, color: '#64748B', letterSpacing: 4 }}>D E M O · 逻 辑</Text>
                    </Box>
                    <Text style={{ fontSize: 13, fontFamily: 'Consolas', color: '#94A3B8' }}>23 / 26</Text>
                </Box>

                <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.3, marginTop: 16 }}>
                    再接数据：main.js
                </Text>
            </Box>

            <Box style={{ flexDirection: 'row', width: '100%', gap: 24 }}>
                <Box style={{ width: 560, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#2563EB', marginBottom: 10 }}>
                        ① 取元素 + 渲染
                    </Text>
                    <CodeBlock language='javascript' theme='github-light' macHeader={false}>
                        {`const baseUrl = 'http://localhost:3000/goods'
const tableBody = document.querySelector('#table-body')
let goodsList = []

function render(list) {
  tableBody.innerHTML = ''
  list.forEach(item => {
    const tr = document.createElement('tr')
    tr.innerHTML = \`
      <td>\${item.id}</td>
      <td>\${item.title}</td>
      <td>\${item.price}</td>
      <td>\${item.stock}</td>\`
    tableBody.appendChild(tr)
  })
}`}
                    </CodeBlock>
                </Box>

                <Box style={{ width: 550, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#F59E0B', marginBottom: 10 }}>
                        ② 查询 · 搜索 · 新增
                    </Text>
                    <CodeBlock language='javascript' theme='github-light' macHeader={false}>
                        {`async function loadGoods() {
  const res = await fetch(baseUrl)
  goodsList = await res.json()
  render(goodsList)
}

searchInput.oninput = function () {
  const kw = this.value.trim().toLowerCase()
  render(goodsList.filter(item =>
    item.title.toLowerCase().includes(kw)))
}

addBtn.onclick = async function () {
  const res = await fetch(baseUrl, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      title: titleInp.value,
      price: Number(priceInp.value),
      stock: Number(stockInp.value) })
  })
  if (res.ok) { alert('新增成功！'); loadGoods() }
}

loadGoods()`}
                    </CodeBlock>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', justifyContent: 'space-between', width: '100%' }}>
                <Text style={{ fontSize: 13, color: '#94A3B8' }}>第9周 · 前端 ↔ 后端接口交互</Text>
                <Text style={{ fontSize: 13, color: '#94A3B8' }}>23 / 26</Text>
            </Box>
        </Box>
    </Slide>
);
